<%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/products.css" />

<body>
  <div class="products-container">
    <%- include('includes/treatment-navigation', { activePage: 'dentists' }) %>
    <div class="restaurant-menu-frame">
      <div class="board">
        <div class="dishes-table">
          <span class="new-dish-txt" style="margin-bottom: 30px">DENTISTS / 의료진 관리</span>
          <table class="table table-bordered table-hover">
            <thead class="thead-light">
              <tr>
                <th>No</th>
                <th>Name</th>
                <th>Specialty</th>
                <th>Status</th>
                <th>Edit</th>
              </tr>
            </thead>
            <tbody style="background: white">
              <% dentists.forEach(function(dentist, index) { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><%= dentist.dentistName %></td>
                  <td><%= dentist.dentistSpecialty %></td>
                  <td><%= dentist.dentistStatus %></td>
                  <td><a class="btn btn-primary btn-sm" href="/admin/dentist/<%= dentist._id %>">Edit</a></td>
                </tr>
              <% }) %>
              <% if (!dentists.length) { %>
                <tr><td colspan="5">No dentists yet.</td></tr>
              <% } %>
            </tbody>
          </table>
          <div class="long-input" style="align-items: flex-end; margin-bottom: 25px">
            <a class="btn btn-primary" href="/admin/dentist/create">New Dentist</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
<%- include('includes/footer') %>
